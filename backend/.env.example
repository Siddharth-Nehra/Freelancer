# FreelancerHub Server Configuration
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/freelancerhub
JWT_SECRET=your_jwt_secret_key_here

# AI Assistant Integration (Configure either Gemini or OpenAI/Groq/OpenRouter)
# 1. Google Gemini (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. OpenAI / Compatible Provider (Optional alternative)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Preferred AI Provider: 'gemini' or 'openai' (auto-detected if omitted)
# AI_PROVIDER=gemini
